# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Data — keep folders, ignore contents
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Run outputs
results/*
!results/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Distribution
build/
dist/
*.egg-info/
