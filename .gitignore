# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Data — raw Olist CSVs are too large for git (120 MB); upload once
# to the deployed volume or regenerate locally with `make download-data`.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
# data/processed/ IS committed — small (~3 MB) and required for the
# simulator to run inside the container without re-preprocessing.

# Run outputs — canonical thesis results ARE committed so the deployed
# dashboard matches the manuscript out of the box. New runs land in the
# `results-data` named volume and are not tracked here.
.DS_Store

# Notebook checkpoints
.ipynb_checkpoints/

# Distribution
build/
dist/
*.egg-info/

# Secrets / runtime artefacts (never commit these)
.env
.env.local
.env.production
*.pem
*.key
backend/inventory_mas.db
backend/inventory_mas.db-journal

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo
node_modules/
