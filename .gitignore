# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Data — keep folders, ignore contents
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Run outputs
results/*
!results/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Distribution
build/
dist/
*.egg-info/

# Secrets / runtime artefacts (never commit these)
.env
.env.local
.env.production
*.pem
*.key
backend/inventory_mas.db
backend/inventory_mas.db-journal

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo
node_modules/
