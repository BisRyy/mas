# Production environment for Dokploy.
# Copy this to `.env.production`, fill in real values, then paste the
# resulting key/value pairs into the Dokploy Application's
# "Environment Variables" panel. Do NOT commit `.env.production` to git.

# === Required ===

# Public domain for the frontend (browser-facing).
APP_DOMAIN=app.yourdomain.example

# Public domain for the backend API (browser will hit /api/* here).
API_DOMAIN=api.yourdomain.example

# === Backend behavior ===

# Comma-separated list of frontend origins allowed to call /api/*.
# Must match APP_DOMAIN exactly (scheme + host, no trailing slash).
MAS_CORS_ORIGINS=https://app.yourdomain.example

# Allow the public to launch new sweeps (as you opted for).
MAS_ALLOW_RUN_LAUNCH=true

# Cap concurrent and queued sweeps to keep a small VM responsive.
MAS_MAX_QUEUED_RUNS=3
MAS_MAX_CONCURRENT_RUNS=1

# Emit per-seed decisions.jsonl so the audit-trail viewer has data.
MAS_EMIT_DECISIONS=1

# === Frontend behavior ===

# Where the browser sends API calls. Must be reachable from the public
# internet. With Dokploy + Traefik this is API_DOMAIN over HTTPS.
NEXT_PUBLIC_API_URL=https://api.yourdomain.example
